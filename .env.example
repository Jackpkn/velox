# ---------------------------------------------------------
# 1. Google Gemini (Direct via Google AI Studio)
# ---------------------------------------------------------
# Uncomment LLM_PROVIDER=gemini and paste your GEMINI_API_KEY to use Gemini directly
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODELS=gemini-4-argon,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-2.5-flash,gemma-4-31b-it
# EXTRACT_MODEL=gemini-2.5-flash

# ---------------------------------------------------------
# 2. Anthropic Claude (Direct)
# ---------------------------------------------------------
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---------------------------------------------------------
# 3. OpenRouter (Multi-model: Gemini + Claude + Mercury)
# ---------------------------------------------------------
# LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODELS=google/gemini-3-flash-preview,google/gemini-2.5-flash,google/gemma-4-31b-it,anthropic/claude-sonnet-5.5

# ---------------------------------------------------------
# 4. Optional: System 1 Fast Actor (TypeSafe Jev)
# ---------------------------------------------------------
FAST_API_KEY=
FAST_BASE_URL=https://api.inceptionlabs.ai/v1
FAST_MODEL=mercury-2

# Browser Mode (1 = invisible headless with CDP stealth, 0 = visible Chrome window)
HEADLESS=1
